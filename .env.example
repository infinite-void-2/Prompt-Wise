# OptiPrompt Server Configuration

# Environment
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Gemini API Configuration (Server-Side Only)
# Get your API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Configurable model ID (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Security & Request Bounds
MAX_PROMPT_CHARS=20000
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Optional Persistence (MongoDB)
# Leave empty to run without database (MVP default)
MONGODB_URI=
ENABLE_PROMPT_HISTORY=false

# Evaluation Suite
# Set to true only when running live LLM evals with a real GEMINI_API_KEY
RUN_LIVE_LLM_EVALS=false
